# =============================================================================
# Financial Filings Analyst — environment template
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
# =============================================================================

# --- LLM providers ---
# Project is fully free-tier. Primary: Groq. Fallback: local Ollama on host.
GROQ_API_KEY=gsk_REPLACE_ME

# Groq model IDs
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_CHEAP=llama-3.1-8b-instant

# --- Ollama (runs on host, not in docker-compose) ---
# From host: http://localhost:11434
# From a backend container: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
OLLAMA_MODEL_HEAVY=qwen2.5:14b-instruct-q4_K_M

# Provider routing
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=ollama

# --- SEC EDGAR ---
# REQUIRED before any ingestion run. SEC fair-use mandates a User-Agent header
# with real contact info. Format: "Name email@example.com"
# An IP ban is the consequence of getting this wrong.
SEC_USER_AGENT="Your Name your.email@gmail.com"

# --- Postgres (corpus + FTS + Langfuse) ---
POSTGRES_USER=ffa
POSTGRES_PASSWORD=ffa_dev_password_change_me
POSTGRES_DB=filings
DATABASE_URL=postgresql+asyncpg://ffa:ffa_dev_password_change_me@postgres:5432/filings

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=filings_chunks

# --- Langfuse (self-hosted via docker compose) ---
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_INIT_ORG_ID=ffa-org
LANGFUSE_INIT_PROJECT_ID=ffa-project
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme_local_only
LANGFUSE_SALT=REPLACE_ME_random_64_chars
LANGFUSE_ENCRYPTION_KEY=REPLACE_ME_64_hex_chars
NEXTAUTH_SECRET=REPLACE_ME_random_64_chars
NEXTAUTH_URL=http://localhost:3000

# --- Langfuse infra deps (only used by docker-compose) ---
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=langfuse_dev
CLICKHOUSE_DB=langfuse
REDIS_AUTH=langfuse_redis_dev
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password

# --- Embeddings & reranker (local; no keys needed) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_DEVICE=auto  # auto|cpu|cuda

# --- Backend runtime ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development  # development|production

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Ticker universe (locked; FY2020-2024 only) ---
FILING_YEARS=2020,2021,2022,2023,2024
TICKERS=MSFT,AAPL,GOOGL,AMZN,META,NVDA,TSLA,AMD,INTC,CRM,ORCL,JPM,BAC,WMT,COST,JNJ,PFE,CAT,XOM,LLY
